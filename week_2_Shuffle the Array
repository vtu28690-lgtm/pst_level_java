class Solution {
    public int[] shuffle(int[] nums, int n) {
        int[] result = new int[2 * n];
        for (int i = 0; i < n; i++) {
            result[2 * i] = nums[i];        // Place x_i at even indices: 0, 2, 4, ...
            result[2 * i + 1] = nums[i + n]; // Place y_i at odd indices: 1, 3, 5, ...
        }
        return result;
    }
}

