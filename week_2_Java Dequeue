import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int k = sc.nextInt();

        int[] arr = new int[n];
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        HashMap<Integer, Integer> freq = new HashMap<>();

        // Add the first window
        for (int i = 0; i < k; i++) {
            freq.put(arr[i], freq.getOrDefault(arr[i], 0) + 1);
        }

        int maxUnique = freq.size();

        // Slide the window
        for (int i = k; i < n; i++) {
            // Remove the element leaving the window
            int outgoing = arr[i - k];
            freq.put(outgoing, freq.get(outgoing) - 1);

            if (freq.get(outgoing) == 0) {
                freq.remove(outgoing);
            }

            // Add the new element
            int incoming = arr[i];
            freq.put(incoming, freq.getOrDefault(incoming, 0) + 1);

            // Update maximum number of unique elements
            maxUnique = Math.max(maxUnique, freq.size());
        }

        System.out.println(maxUnique);

        sc.close();
    }
}




